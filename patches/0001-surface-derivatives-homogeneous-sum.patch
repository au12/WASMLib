diff --git a/source/SMLib/src/NL_SrfNurb.cpp b/source/SMLib/src/NL_SrfNurb.cpp
index 7ba7ff2..9383a1a 100644
--- a/source/SMLib/src/NL_SrfNurb.cpp
+++ b/source/SMLib/src/NL_SrfNurb.cpp
@@ -1921,8 +1921,6 @@ NL_FLAG N_SrfDerivs
 
     NL_CPOINT ** Pw;
 
-    NL_BASISDERIVATIVES BD;
-
     NL_BOOLEAN noW;
     NL_BOOLEAN noZ;
 
@@ -1937,24 +1935,132 @@ NL_FLAG N_SrfDerivs
     /* knv = sur->knv; */
     Pw = sur->net->Pw;
 
-    /* Make pointer assignments */
-
-    /* Compute basis function derivatives */
-    error = N_SrfBasisDerivs( sur, u, v, ufl, vfl, mfl, udr, vdr, BD, &usp, &vsp );
-
-    if( error EQ NL_YES )
-        NL_OUT;
-
-    /* Compute derivatives */
+    /* WASMLib: the homogeneous derivatives summed once over the control net, then the quotient rule applied to the
+       point (The NURBS Book, A4.4) — the same values as taking every basis function's rational derivatives first
+       (N_SrfBasisDerivs) and summing those, for a fraction of the work. */
+    {
+        if (udr GT NL_MAXDER OR vdr GT NL_MAXDER)
+        {
+            N_ErrSet(NL_MXD_ERR, rname);
+            error = NL_YES;
+            NL_OUT;
+        }
+        error = N_BasisFindSpan(sur->knu, p, u, ufl, &usp);
+        if (error EQ NL_YES)
+            NL_OUT;
+        error = N_BasisFindSpan(sur->knv, q, v, vfl, &vsp);
+        if (error EQ NL_YES)
+            NL_OUT;
 
-    l2 = usp - p;
-    l3 = vsp - q;
+        NL_BASISFUNCTIONS ndu;
+        NL_DERIVATIVES DU, DV;
+        const NL_INDEX mu = NL_MIN(p, udr), mv = NL_MIN(q, vdr);
+        N_ComputeBasisFunctions(p, u, sur->knu->U, usp, ndu);
+        for (NL_INDEX j = 0; j <= p; j++)
+            DU[0][j] = ndu[j][p];
+        N_ComputeDerivatives(p, mu, ndu, DU);
+        for (NL_INDEX k = 1, r = p; k <= mu; k++)
+        {
+            for (NL_INDEX j = 0; j <= p; j++)
+                DU[k][j] *= r;
+            r *= (p - k);
+        }
+        N_ComputeBasisFunctions(q, v, sur->knv->U, vsp, ndu);
+        for (NL_INDEX j = 0; j <= q; j++)
+            DV[0][j] = ndu[j][q];
+        N_ComputeDerivatives(q, mv, ndu, DV);
+        for (NL_INDEX k = 1, r = q; k <= mv; k++)
+        {
+            for (NL_INDEX j = 0; j <= q; j++)
+                DV[k][j] *= r;
+            r *= (q - k);
+        }
 
-    noW = (Pw[0][0].w == NL_NOW);
-    noZ = (Pw[0][0].z == NL_NOZ);
+        noW = (Pw[0][0].w == NL_NOW);
+        noZ = (Pw[0][0].z == NL_NOZ);
+        const NL_BOOLEAN upper = (mfl EQ NL_TRUE AND udr EQ vdr);
+        l2 = usp - p;
+        l3 = vsp - q;
+
+        /* A[k][l] = sum over the span's control points of DU[k][i] DV[l][j] Pw[i][j] (x, y, z, w; homogeneous) */
+        NL_REAL A[NL_MAXDER + 1][NL_MAXDER + 1][4];
+        for (NL_INDEX k = 0; k <= udr; k++)
+            for (NL_INDEX l = 0; l <= vdr; l++)
+                A[k][l][0] = A[k][l][1] = A[k][l][2] = A[k][l][3] = 0.0;
+        for (NL_INDEX l = 0; l <= mv; l++)
+        {
+            NL_REAL T[NL_MAXDEG + 1][4];
+            for (NL_INDEX i = 0; i <= p; i++)
+            {
+                const NL_CPOINT* row = &Pw[l2 + i][l3];
+                NL_REAL tx = 0.0, ty = 0.0, tz = 0.0, tw = 0.0;
+                for (NL_INDEX j = 0; j <= q; j++)
+                {
+                    const NL_REAL d = DV[l][j];
+                    tx += d * row[j].x;
+                    ty += d * row[j].y;
+                    if (!noZ) tz += d * row[j].z;
+                    if (!noW) tw += d * row[j].w;
+                }
+                T[i][0] = tx; T[i][1] = ty; T[i][2] = tz; T[i][3] = tw;
+            }
+            const NL_INDEX kmax = NL_MIN(mu, upper ? udr - l : udr);
+            for (NL_INDEX k = 0; k <= kmax; k++)
+            {
+                NL_REAL ax = 0.0, ay = 0.0, az = 0.0, aw = 0.0;
+                for (NL_INDEX i = 0; i <= p; i++)
+                {
+                    const NL_REAL d = DU[k][i];
+                    ax += d * T[i][0]; ay += d * T[i][1]; az += d * T[i][2]; aw += d * T[i][3];
+                }
+                A[k][l][0] = ax; A[k][l][1] = ay; A[k][l][2] = az; A[k][l][3] = aw;
+            }
+        }
 
-    N_ComputeDerivativeMatrix(noW, noZ,
-        mfl EQ NL_TRUE AND udr EQ vdr, p, q, udr, vdr, Pw, l2, l3, BD, SD);
+        if (noW)
+        {
+            for (NL_INDEX k = 0; k <= udr; k++)
+                for (NL_INDEX l = 0; l <= (upper ? (udr - k) : vdr); l++)
+                {
+                    SD[k][l].x = A[k][l][0];
+                    SD[k][l].y = A[k][l][1];
+                    SD[k][l].z = noZ ? 0.0 : A[k][l][2];
+                }
+        }
+        else
+        {
+            if (N_FloatOpIsBad(1.0, A[0][0][3], NL_DIVISION))
+                NL_ERROR(NL_CON_ERR);
+            const NL_REAL invW = 1.0 / A[0][0][3];
+            for (NL_INDEX k = 0; k <= udr; k++)
+            {
+                for (NL_INDEX l = 0; l <= (upper ? (udr - k) : vdr); l++)
+                {
+                    NL_REAL vx = A[k][l][0], vy = A[k][l][1], vz = A[k][l][2];
+                    for (NL_INDEX j = 1; j <= l; j++)
+                    {
+                        const NL_REAL c = NL_PascalTri[l][j] * A[0][j][3];
+                        vx -= c * SD[k][l - j].x; vy -= c * SD[k][l - j].y; vz -= c * SD[k][l - j].z;
+                    }
+                    for (NL_INDEX i = 1; i <= k; i++)
+                    {
+                        const NL_REAL c = NL_PascalTri[k][i] * A[i][0][3];
+                        vx -= c * SD[k - i][l].x; vy -= c * SD[k - i][l].y; vz -= c * SD[k - i][l].z;
+                        NL_REAL wx = 0.0, wy = 0.0, wz = 0.0;
+                        for (NL_INDEX j = 1; j <= l; j++)
+                        {
+                            const NL_REAL c2 = NL_PascalTri[l][j] * A[i][j][3];
+                            wx += c2 * SD[k - i][l - j].x; wy += c2 * SD[k - i][l - j].y; wz += c2 * SD[k - i][l - j].z;
+                        }
+                        vx -= NL_PascalTri[k][i] * wx; vy -= NL_PascalTri[k][i] * wy; vz -= NL_PascalTri[k][i] * wz;
+                    }
+                    SD[k][l].x = vx * invW;
+                    SD[k][l].y = vy * invW;
+                    SD[k][l].z = noZ ? 0.0 : vz * invW;
+                }
+            }
+        }
+    }
         
     /* Exit */
 
